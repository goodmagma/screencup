{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screencup",
  "version": "0.3.0",
  "identifier": "com.goodmagma.screencup",
  "build": {
    "beforeDevCommand": "npm run build:sidecars && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:sidecars && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Screencup",
        "width": 980,
        "height": 640,
        "minWidth": 640,
        "minHeight": 420,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: thumb: http://thumb.localhost data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "licenses/LICENSE.txt",
      "../THIRD-PARTY-NOTICES.md": "licenses/THIRD-PARTY-NOTICES.md",
      "binaries/licenses/ffmpeg/": "licenses/ffmpeg/",
      "binaries/licenses/THIRD-PARTY-LICENSES.txt": "licenses/THIRD-PARTY-LICENSES.txt"
    },
    "externalBin": [
      "binaries/screencup-overlay",
      "binaries/ffmpeg"
    ],
    "shortDescription": "Screenshot e registrazioni dello schermo",
    "publisher": "goodmagma",
    "copyright": "Copyright (c) 2026 goodmagma",
    "license": "MIT",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Italian",
          "Spanish",
          "French",
          "German",
          "Portuguese"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzQTBFOEFEOEE3NDk0OUIKUldTYmxIU0tyZWlnUXdEbzdSN3ZYSzhyNUFsaDJrU05Tbk1ueE1ybVROTTdxZmxwaDlWZVJYcU8K",
      "endpoints": [
        "https://github.com/goodmagma/screencup/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

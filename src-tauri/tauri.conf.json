{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screencup",
  "version": "0.1.0",
  "identifier": "com.goodmagma.screencup",
  "build": {
    "beforeDevCommand": "npm run build:sidecars && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:sidecars && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Screencup",
        "width": 980,
        "height": 640,
        "minWidth": 640,
        "minHeight": 420,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: thumb: http://thumb.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/screencup-overlay",
      "binaries/ffmpeg"
    ],
    "shortDescription": "Screenshot e registrazioni dello schermo",
    "publisher": "goodmagma",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Italian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}

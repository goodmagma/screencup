{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the gallery window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$PICTURE/Screencup/**"
        }
      ]
    }
  ]
}
